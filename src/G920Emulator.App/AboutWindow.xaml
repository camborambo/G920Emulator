<Window x:Class="G920Emulator.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About G920 Emulator"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="20">
    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="Close" Width="110"
            HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="Close_Click" Margin="0,16,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="G920 Emulator" FontSize="22" FontWeight="SemiBold" FontFamily="Bahnschrift"/>
        <TextBlock x:Name="VersionText" Opacity="0.65" Margin="0,4,0,0"/>
        <TextBlock Margin="0,10,0,0">
          <Run Text="by "/>
          <Hyperlink NavigateUri="https://stachenscale.com/" RequestNavigate="AuthorLink_RequestNavigate"
                     Foreground="#8AB4F8" TextDecorations="None">CamboRambo</Hyperlink>
        </TextBlock>

        <TextBlock Text="Disclaimer" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.85" LineHeight="20"
                   Text="This software is not affiliated with, endorsed by, or sponsored by Logitech, Microsoft, Nefarius Software Solutions, Fanatec, or any other hardware or game publisher."/>
        <TextBlock TextWrapping="Wrap" Opacity="0.85" LineHeight="20" Margin="0,10,0,0"
                   Text="G920 Emulator relies on third-party components (including WinUHid and HidHide). Installing drivers, enabling Windows test signing, or changing Secure Boot settings can affect system security and stability. You use those tools and this app at your own risk."/>
        <TextBlock TextWrapping="Wrap" Opacity="0.85" LineHeight="20" Margin="0,10,0,0"
                   Text="Provided AS IS, without warranty of any kind. The author is not liable for damage, data loss, bans, or other consequences from use of this software."/>

        <TextBlock Text="Third-party" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.75" LineHeight="20"
                   Text="Uses WinUHid by cgutman (bundled) and HidHide by Nefarius Software Solutions (separate install). Those projects keep their own licenses and trademarks."/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
