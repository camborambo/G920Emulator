<Window x:Class="G920Emulator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="G920 Emulator"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="760" Width="1280"
        MinHeight="640" MinWidth="1000"
        Background="{StaticResource BgApp}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">
  <DockPanel Margin="12">
    <!-- Tabs (left) · Start | profile (right) -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <DockPanel LastChildFill="False" Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="StartButton" Click="BridgeToggle_Click"
                  Style="{StaticResource BridgeToggleStart}" Margin="0,0,14,0"
                  ToolTip="Start the virtual G920">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <iconPacks:PackIconMaterial x:Name="BridgeGlyph" Kind="Play" Width="14" Height="14"
                                          Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="BridgeLabel" Text="Start" FontWeight="SemiBold" FontSize="13"
                         Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Width="1" Height="22" Background="{StaticResource BorderSubtle}"
                  Margin="0,0,14,0" VerticalAlignment="Center"/>
          <TextBlock Text="Profile" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0"
                     ToolTip="Input profile — bindings / devices. Force Feedback has its own profiles on the Force Feedback tab."/>
          <ComboBox x:Name="SavedProfilesCombo" Width="220" VerticalAlignment="Center" Margin="0,0,6,0"
                    SelectionChanged="SavedProfilesCombo_SelectionChanged"
                    ToolTip="Input profile — bindings / devices. Force Feedback has its own profiles on the Force Feedback tab."/>
          <Button Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="SaveButton_Click"
                  ToolTip="Save">
            <iconPacks:PackIconMaterial Kind="ContentSave" Width="14" Height="14" Foreground="#E8EAED"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="SaveAsButton_Click"
                  ToolTip="Save As…">
            <iconPacks:PackIconMaterial Kind="ContentSavePlus" Width="14" Height="14" Foreground="#E8EAED"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="RenameProfileButton_Click"
                  ToolTip="Rename…">
            <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Foreground="#E8EAED"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Margin="0" Click="DeleteProfileButton_Click"
                  ToolTip="Delete">
            <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14" Foreground="#E8EAED"/>
          </Button>
          <Border Width="1" Height="22" Background="{StaticResource BorderSubtle}"
                  Margin="14,0,14,0" VerticalAlignment="Center"/>
          <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="SettingsButton_Click"
                  ToolTip="Settings">
            <iconPacks:PackIconMaterial Kind="CogOutline" Width="14" Height="14" Foreground="#E8EAED"/>
            <Button.ContextMenu>
              <ContextMenu x:Name="SettingsMenu">
                <MenuItem x:Name="RestoreMenuItem" Header="Restore" Click="RestoreFromTrayMenu_Click"
                          Visibility="Collapsed"/>
                <Separator x:Name="RestoreMenuSeparator" Visibility="Collapsed"/>
                <MenuItem Header="Manage dependencies" Click="DependenciesButton_Click"
                          ToolTip="Install, uninstall, or recheck WinUHid, HidHide, and test signing."/>
                <MenuItem x:Name="MinimizeToTrayMenuItem" Header="Minimize to system tray"
                          IsCheckable="True" Click="MinimizeToTrayMenuItem_Click"
                          ToolTip="When on, minimizing hides the window in the notification area. The close button still quits."/>
                <MenuItem x:Name="DebugOverlayMenuItem" Header="Debug Overlay"
                          IsCheckable="True" Click="DebugOverlayMenuItem_Click"
                          ToolTip="Show a topmost overlay with live G920 inputs and FFB diagnostics while you drive."/>
                <Separator/>
                <MenuItem Header="Exit" Click="ExitApp_Click" ToolTip="Quit G920 Emulator."/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
        <Border Background="#0E1116" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                CornerRadius="10" Padding="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="InputTabRadio" Style="{StaticResource MainTabRadio}"
                         GroupName="MainTabs" IsChecked="True" Checked="MainTab_Checked">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Equalizer" Width="14" Height="14"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Input" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="FfbTabRadio" Style="{StaticResource MainTabRadio}" Margin="0"
                         GroupName="MainTabs" Checked="MainTab_Checked">
              <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="LightningBolt" Width="14" Height="14"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Force Feedback" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
      </DockPanel>
      <Border Height="1" Background="{StaticResource BorderSubtle}"/>
    </StackPanel>

    <StatusBar DockPanel.Dock="Bottom" Background="#0E1116" Foreground="#AAB0BB" Margin="0,8,0,0">
      <StatusBar.ItemsPanel>
        <ItemsPanelTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
          </Grid>
        </ItemsPanelTemplate>
      </StatusBar.ItemsPanel>
      <StatusBarItem Grid.Column="0">
        <TextBlock x:Name="StatusText" Text="Ready"/>
      </StatusBarItem>
      <StatusBarItem Grid.Column="1" HorizontalAlignment="Right" Padding="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7">
            <Run Text="by " Foreground="#AAB0BB"/>
            <Hyperlink NavigateUri="https://stachenscale.com/" RequestNavigate="AuthorLink_RequestNavigate"
                       Foreground="#8AB4F8" TextDecorations="None">CamboRambo</Hyperlink>
          </TextBlock>
          <Button x:Name="DebugSessionButton" Style="{StaticResource AppButton}" Content="Debug"
                  Padding="10,4" Margin="0,0,6,0" FontSize="12"
                  Click="DebugSessionButton_Click"
                  ToolTip="Start a debug session to capture OEM / HID++ logs. Stop when done, then Export log."/>
          <Button x:Name="ExportDebugLogButton" Style="{StaticResource AppButton}" Content="Export log…"
                  Padding="10,4" Margin="0,0,6,0" FontSize="12" IsEnabled="False"
                  Click="ExportDebugLogButton_Click"
                  ToolTip="Export diagnostics after you stop a Debug session"/>
          <Button Style="{StaticResource AppButton}" Content="About" Padding="10,4" Margin="0"
                  FontSize="12" Click="AboutButton_Click" ToolTip="Credits and disclaimer"/>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <!-- Dependencies — compact strip above status bar -->
    <Border x:Name="DependenciesBanner" DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,8,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource AppButton}" Content="Recheck" Click="RecheckDependencies_Click" Padding="10,5"/>
          <Button x:Name="DependenciesActionButton" Content="Fix" Click="DependenciesButton_Click"
                  Style="{StaticResource AccentButton}" Margin="0" Padding="10,5"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="System Dependencies" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
          <Border x:Name="TestSigningChip" CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
            <TextBlock x:Name="TestSigningChipText" FontWeight="SemiBold" FontSize="12"/>
          </Border>
          <Border x:Name="WinUHidChip" CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
            <TextBlock x:Name="WinUHidChipText" FontWeight="SemiBold" FontSize="12"/>
          </Border>
          <Border x:Name="HidHideChip" CornerRadius="8" Padding="8,4" Margin="0">
            <TextBlock x:Name="HidHideChipText" FontWeight="SemiBold" FontSize="12"/>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <Grid x:Name="InputPanel">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: live input test + detected devices -->
                <Grid Grid.Column="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>

                  <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,10">
                        <Border Background="#222836" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                          <TextBlock x:Name="StripGearText" Text="GEAR N" FontWeight="Bold" FontFamily="Bahnschrift"
                                     FontSize="16" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="GearText" Visibility="Collapsed" Text="Gear: N"/>
                        <TextBlock x:Name="ButtonsText" DockPanel.Dock="Right" Text="Buttons: —" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                   Opacity="0.9" Margin="10,0,0,0"
                                   ToolTip="Pressed virtual G920 buttons while the bridge is running"/>
                      </DockPanel>
                      <TextBlock x:Name="StripSteerText" Text="Steering: 0.00" FontSize="11" Opacity="0.85"/>
                      <ProgressBar x:Name="StripSteerBar" Height="7" Minimum="-1" Maximum="1" Value="0" Margin="0,3,0,8"
                                   Foreground="#2A9D8F"/>
                      <TextBlock x:Name="SteerText" Visibility="Collapsed"/>
                      <ProgressBar x:Name="SteerBar" Visibility="Collapsed" Minimum="-1" Maximum="1"/>
                      <TextBlock x:Name="StripThrottleText" Text="Throttle: 0%" FontSize="11" Opacity="0.85"/>
                      <ProgressBar x:Name="StripThrottleBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,3,0,8"
                                   Foreground="#1F6F4A"/>
                      <TextBlock x:Name="ThrottleText" Visibility="Collapsed"/>
                      <ProgressBar x:Name="ThrottleBar" Visibility="Collapsed" Minimum="0" Maximum="1"/>
                      <TextBlock x:Name="StripBrakeText" Text="Brake: 0%" FontSize="11" Opacity="0.85"/>
                      <ProgressBar x:Name="StripBrakeBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,3,0,8"
                                   Foreground="#B33A3A"/>
                      <TextBlock x:Name="BrakeText" Visibility="Collapsed"/>
                      <ProgressBar x:Name="BrakeBar" Visibility="Collapsed" Minimum="0" Maximum="1"/>
                      <TextBlock x:Name="StripClutchText" Text="Clutch: 0%" FontSize="11" Opacity="0.85"/>
                      <ProgressBar x:Name="StripClutchBar" Height="7" Minimum="0" Maximum="1" Value="0" Margin="0,3,0,0"
                                   Foreground="#C9A227"/>
                      <TextBlock x:Name="ClutchText" Visibility="Collapsed"/>
                      <ProgressBar x:Name="ClutchBar" Visibility="Collapsed" Minimum="0" Maximum="1"/>
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10">
                    <DockPanel>
                      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Detected devices" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AppButton}" Content="Refresh" Click="RefreshButton_Click"
                                Padding="10,5" Margin="0" HorizontalAlignment="Right"
                                ToolTip="Re-scan DirectInput devices and restore any you hid from this list"/>
                      </DockPanel>
                      <TextBlock DockPanel.Dock="Bottom" x:Name="BindHintText"
                                 Text="Click a G920 binding to Assign. Buttons also accept axes (axis→button)."
                                 Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                      <ListBox x:Name="DeviceList" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                      Width="26" Height="26" MinWidth="26" MinHeight="26" Padding="4"
                                      VerticalAlignment="Center"
                                      Click="RemoveDevice_Click"
                                      ToolTip="Hide this device from the list. Refresh to show it again.">
                                <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" Foreground="#E8EAED"/>
                              </Button>
                              <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Id}" FontSize="11" Opacity="0.55"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           ToolTip="DirectInput instance ID"/>
                              </StackPanel>
                            </DockPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </DockPanel>
                  </Border>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="10">
                  <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                      <TextBlock Text="G920 bindings" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                      <Button DockPanel.Dock="Right" Style="{StaticResource AppButton}" Content="Clear all" Click="ClearAllBindings_Click"
                              Margin="0" HorizontalAlignment="Right" Padding="10,5"
                              ToolTip="Clear every G920 binding in this profile"/>
                    </DockPanel>
                    <ListBox x:Name="BindingList" MouseLeftButtonUp="BindingList_MouseLeftButtonUp"
                             BorderThickness="0" Background="Transparent">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Padding" Value="8,6"/>
                          <Setter Property="Cursor" Value="Hand"/>
                          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold"/>
                              <TextBlock Grid.Column="1" Text="{Binding SourceText}" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <DockPanel Margin="0,6,0,0" Visibility="{Binding DeadzoneVisibility}">
                              <TextBlock Text="{Binding DeadzoneLabel}" Width="72" Opacity="0.7" VerticalAlignment="Center" FontSize="12"/>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding DeadzoneText}" Width="36"
                                         Opacity="0.85" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                              <Slider Minimum="{Binding DeadzoneMinimum}" Maximum="{Binding DeadzoneMaximum}"
                                      TickFrequency="0.01" IsSnapToTickEnabled="False"
                                      Value="{Binding Deadzone, Mode=TwoWay}"
                                      Margin="8,0"
                                      ToolTip="{Binding DeadzoneToolTip}"
                                      PreviewMouseLeftButtonDown="DeadzoneSlider_PreviewMouseLeftButtonDown"/>
                            </DockPanel>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>
              </Grid>

      <ScrollViewer x:Name="FfbPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid ToolTipService.ShowDuration="30000" ToolTipService.InitialShowDelay="400">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Left: profile, device, master, effect gains -->
                  <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock Text="FFB profile" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"
                                     ToolTip="Saved force feedback settings for this setup. Separate from input profiles."/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="SaveFfbButton_Click"
                                    ToolTip="Save current settings to the selected FFB profile.">
                              <iconPacks:PackIconMaterial Kind="ContentSave" Width="14" Height="14" Foreground="#E8EAED"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="SaveFfbAsButton_Click"
                                    ToolTip="Save current settings as a new FFB profile.">
                              <iconPacks:PackIconMaterial Kind="ContentSavePlus" Width="14" Height="14" Foreground="#E8EAED"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="DefaultFfbButton_Click"
                                    ToolTip="Reset sliders to Raw defaults. Save to keep the change.">
                              <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Foreground="#E8EAED"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="0" Click="DeleteFfbButton_Click"
                                    ToolTip="Delete the selected FFB profile. Raw cannot be deleted.">
                              <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="14" Height="14" Foreground="#E8EAED"/>
                            </Button>
                          </StackPanel>
                        </DockPanel>
                        <ComboBox x:Name="FfbProfilesCombo" Margin="0,0,0,12" VerticalAlignment="Center"
                                  ToolTip="Select an FFB profile. Raw leaves the game's feedback unchanged."
                                  SelectionChanged="FfbProfilesCombo_SelectionChanged"/>
                        <TextBlock Text="FFB output device" Opacity="0.7" Margin="0,0,0,4"
                                   ToolTip="Physical wheel base that plays force feedback."/>
                        <ComboBox x:Name="FfbDeviceCombo" DisplayMemberPath="Display" SelectionChanged="FfbDeviceCombo_SelectionChanged"
                                  ToolTip="Physical wheel base that plays force feedback."/>
                        <DockPanel Margin="0,12,0,0"
                                   ToolTip="Overall force feedback strength. 100% matches the game; higher values boost output.">
                          <TextBlock Text="Master" Width="88" VerticalAlignment="Center"/>
                          <TextBlock x:Name="GainValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                                     Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                          <Slider x:Name="GainSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="GainSlider_ValueChanged"/>
                        </DockPanel>
                        <CheckBox x:Name="InvertFfbCheck" Content="Invert FFB" Margin="0,10,0,0"
                                  ToolTip="Reverses force direction."
                                  Checked="InvertFfbCheck_Changed" Unchecked="InvertFfbCheck_Changed"/>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                      <StackPanel>
                        <TextBlock Text="Effect gains" Style="{StaticResource SectionTitle}"
                                   ToolTip="Scale each force feedback effect type. 100% = as sent by the game, 0% = muted. Bind assigns hardware buttons that change that gain while you drive."/>
                        <DockPanel Margin="0,2,0,0"
                                   ToolTip="Main steering torque from tire load, road feel, and impacts.">
                          <TextBlock Text="Constant" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainConstantValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbConstant" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Constant" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainConstantSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Pulls the wheel toward center, stronger the farther you turn.">
                          <TextBlock Text="Spring" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainSpringValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbSpring" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Spring" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainSpringSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Resists how quickly you turn the wheel.">
                          <TextBlock Text="Damper" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainDamperValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbDamper" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Damper" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainDamperSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Constant drag whenever the wheel is moving.">
                          <TextBlock Text="Friction" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainFrictionValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbFriction" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Friction" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainFrictionSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Makes the wheel feel heavier by resisting changes in turning speed.">
                          <TextBlock Text="Inertia" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainInertiaValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbInertia" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Inertia" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainInertiaSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Vibration effects such as rumble, gravel, and crash shake.">
                          <TextBlock Text="Periodic" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainPeriodicValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbPeriodic" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Periodic" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainPeriodicSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0"
                                   ToolTip="Force that ramps from one strength to another over time.">
                          <TextBlock Text="Ramp" Width="88" VerticalAlignment="Center"/>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="GainRampValueText" Width="40" Text="100%" VerticalAlignment="Center"
                                       TextAlignment="Right" Cursor="Hand" ToolTip="Click to type a value"
                                       MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Button x:Name="BindFfbRamp" Style="{StaticResource FfbBindButton}" Content="Bind"
                                    Tag="Ramp" Click="FfbEffectBind_Click"/>
                          </StackPanel>
                          <Slider x:Name="GainRampSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                  ValueChanged="EffectGainSlider_ValueChanged"/>
                        </DockPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- Right: feel, shaping, centering, advanced -->
                  <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <Expander Header="Output feel" IsExpanded="True"
                                ToolTip="Optional filtering applied to the final force before it reaches your wheel.">
                        <StackPanel Margin="0,8,0,0">
                          <DockPanel Margin="0,2,0,0"
                                     ToolTip="Softens harsh detail. Higher values feel smoother but add a little delay. 0 = off.">
                            <TextBlock Text="Smoothing" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FeelSmoothingValueText" DockPanel.Dock="Right" Width="40" Text="0 ms" VerticalAlignment="Center"
                                       Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Slider x:Name="FeelSmoothingSlider" Minimum="0" Maximum="40" Value="0" TickFrequency="1"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="Softens the strongest peaks (crashes, big curbs). 100% = off; lower = gentler peaks.">
                            <TextBlock Text="Peak soft" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FeelPeakSoftValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                                       Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Slider x:Name="FeelPeakSoftSlider" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.01"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="Fades force in when FFB first starts, instead of a sudden jolt. 0 = off.">
                            <TextBlock Text="Soft start" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FeelSoftStartValueText" DockPanel.Dock="Right" Width="40" Text="0" VerticalAlignment="Center"
                                       Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Slider x:Name="FeelSoftStartSlider" Minimum="0" Maximum="2000" Value="0" TickFrequency="50"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                        </StackPanel>
                      </Expander>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <Expander Header="Torque shaping" IsExpanded="True"
                                ToolTip="Optional cleanup for noisy or jumpy force feedback.">
                        <StackPanel Margin="0,8,0,0">
                          <DockPanel Margin="0,2,0,0"
                                     ToolTip="Ignores very small forces near center so the wheel does not twitch. 0 = off.">
                            <TextBlock Text="Deadband" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FeelDeadbandValueText" DockPanel.Dock="Right" Width="48" Text="0" VerticalAlignment="Center"
                                       Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Slider x:Name="FeelDeadbandSlider" Minimum="0" Maximum="0.05" Value="0" TickFrequency="0.001"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="Limits how fast force can change. Lower is smoother; 0 = unlimited.">
                            <TextBlock Text="Slew" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FeelSlewValueText" DockPanel.Dock="Right" Width="48" Text="off" VerticalAlignment="Center"
                                       Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Slider x:Name="FeelSlewSlider" Minimum="0" Maximum="200" Value="0" TickFrequency="1"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="Caps the largest force jump in one update. 100% = off.">
                            <TextBlock Text="Spike cap" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FeelSpikeValueText" DockPanel.Dock="Right" Width="48" Text="100%" VerticalAlignment="Center"
                                       Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Slider x:Name="FeelSpikeSlider" Minimum="0.05" Maximum="1" Value="1" TickFrequency="0.01"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="Ignores tiny force changes to reduce chatter or buzzing. 0 = off.">
                            <TextBlock Text="DI epsilon" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FeelEpsilonValueText" DockPanel.Dock="Right" Width="48" Text="0" VerticalAlignment="Center"
                                       Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Slider x:Name="FeelEpsilonSlider" Minimum="0" Maximum="64" Value="0" TickFrequency="1"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                        </StackPanel>
                      </Expander>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <Expander Header="Centering" IsExpanded="True"
                                ToolTip="Extra return-to-center spring for games that leave the wheel loose.">
                        <StackPanel Margin="0,8,0,0">
                          <CheckBox x:Name="ForceCenterCheck" Content="Force center spring"
                                    Checked="ForceCenterCheck_Changed" Unchecked="ForceCenterCheck_Changed"
                                    ToolTip="Adds a centering spring based on your wheel angle, including menus and pause."/>
                          <StackPanel x:Name="CenterSpringPanel" Margin="0,4,0,0" IsEnabled="False" Opacity="0.5">
                            <DockPanel Margin="0,2,0,0"
                                       ToolTip="Maximum centering force. Scaled by Master.">
                              <TextBlock Text="Strength" Width="88" VerticalAlignment="Center"/>
                              <TextBlock x:Name="CenterStrengthValueText" DockPanel.Dock="Right" Width="48" Text="30%" VerticalAlignment="Center"
                                         Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Slider x:Name="CenterStrengthSlider" Minimum="0.05" Maximum="1" Value="0.3" TickFrequency="0.01"
                                      ValueChanged="FeelSlider_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0"
                                       ToolTip="How far from center the spring reaches full strength. Lower is stiffer near center.">
                              <TextBlock Text="Range" Width="88" VerticalAlignment="Center"/>
                              <TextBlock x:Name="CenterRangeValueText" DockPanel.Dock="Right" Width="48" Text="25%" VerticalAlignment="Center"
                                         Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Slider x:Name="CenterRangeSlider" Minimum="0.05" Maximum="0.5" Value="0.25" TickFrequency="0.01"
                                      ValueChanged="FeelSlider_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0"
                                       ToolTip="Free zone around center where the spring does not push. 0 = off.">
                              <TextBlock Text="Deadzone" Width="88" VerticalAlignment="Center"/>
                              <TextBlock x:Name="CenterDeadzoneValueText" DockPanel.Dock="Right" Width="48" Text="off" VerticalAlignment="Center"
                                         Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                              <Slider x:Name="CenterDeadzoneSlider" Minimum="0" Maximum="0.05" Value="0" TickFrequency="0.001"
                                      ValueChanged="FeelSlider_ValueChanged"/>
                            </DockPanel>
                          </StackPanel>
                        </StackPanel>
                      </Expander>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <Expander Header="Advanced mix" IsExpanded="False"
                                ToolTip="Fine-tune damper response and constant-force direction.">
                        <StackPanel Margin="0,8,0,0">
                          <CheckBox x:Name="InvertConstantForceCheck" Content="Invert Constant Force" Margin="0,0,0,4"
                                    ToolTip="Reverses only the constant-force effect. Independent of Invert FFB."
                                    Checked="MixOption_Changed" Unchecked="MixOption_Changed"/>
                          <DockPanel Margin="0,2,0,0"
                                     ToolTip="How strongly wheel speed feeds into damper and inertia. 100% = as the game sent it.">
                            <TextBlock Text="Damp vel" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DamperVelScaleValueText" DockPanel.Dock="Right" Width="48" Text="100%" VerticalAlignment="Center"
                                       Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Slider x:Name="DamperVelScaleSlider" Minimum="0.25" Maximum="4" Value="1" TickFrequency="0.05"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                          <DockPanel Margin="0,4,0,0"
                                     ToolTip="How soon damper engages near zero speed. Lower engages sooner. 100% = as the game sent it.">
                            <TextBlock Text="Damp dead" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DamperDeadbandScaleValueText" DockPanel.Dock="Right" Width="48" Text="100%" VerticalAlignment="Center"
                                       Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                            <Slider x:Name="DamperDeadbandScaleSlider" Minimum="0.1" Maximum="1" Value="1" TickFrequency="0.01"
                                    ValueChanged="FeelSlider_ValueChanged"/>
                          </DockPanel>
                        </StackPanel>
                      </Expander>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                      <Expander x:Name="FfbDebugExpander" Header="FFB debug" IsExpanded="False"
                                Expanded="FfbDebugExpander_ExpandedChanged"
                                Collapsed="FfbDebugExpander_ExpandedChanged"
                                ToolTip="Test force feedback and view live effect counters.">
                        <StackPanel Margin="0,8,0,0">
                          <TextBlock Text="Send test forces to your FFB wheel. No game required."
                                     Opacity="0.65" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                          <WrapPanel Margin="0,0,0,4">
                            <Button Style="{StaticResource WrapButton}" Content="Attach FFB" Click="FfbAttach_Click"
                                    ToolTip="Connect force feedback to the selected wheel."/>
                            <Button Style="{StaticResource WrapButton}" Content="Left" Click="FfbTestLeft_Click"/>
                            <Button Style="{StaticResource WrapButton}" Content="Center" Click="FfbTestCenter_Click"
                                    ToolTip="Toggle a return-to-center spring test."/>
                            <Button Style="{StaticResource WrapButton}" Content="Right" Click="FfbTestRight_Click"/>
                            <Button Style="{StaticResource WrapButton}" Content="Pulse" Click="FfbTestPulse_Click"
                                    ToolTip="Short left/right pulse."/>
                            <Button Style="{StaticResource WrapButton}" Content="Release test" Click="FfbTestRelease_Click"
                                    Margin="0,0,0,8"
                                    ToolTip="Clear the test force so game FFB can drive again."/>
                          </WrapPanel>
                          <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Test torque" Width="88" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FfbTestTorqueValueText" DockPanel.Dock="Right" Width="48"
                                       Text="0%" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <Slider x:Name="FfbTestTorqueSlider" Minimum="-1" Maximum="1" Value="0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False"
                                    ValueChanged="FfbTestTorqueSlider_ValueChanged"/>
                          </DockPanel>
                          <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <TextBlock x:Name="FfbDiagText" Opacity="0.8" FontSize="12"
                                       FontFamily="Consolas" TextWrapping="NoWrap"
                                       Text="FFB diagnostics will appear here."/>
                          </ScrollViewer>
                        </StackPanel>
                      </Expander>
                    </Border>

                    <TextBlock x:Name="DriverText" Text="" Opacity="0.65" TextWrapping="Wrap" Margin="0,12,0,0"/>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
