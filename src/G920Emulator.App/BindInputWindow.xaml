<Window x:Class="G920Emulator.App.BindInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bind input"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="500" Width="500"
        MinHeight="440" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#121418"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="Foreground" Value="#E8EAED"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Clear all" Click="Clear_Click" ToolTip="Remove every source from this binding"/>
      <Button Content="Cancel" Click="Cancel_Click"/>
      <Button Content="OK" Click="Ok_Click" Background="#1F6F4A" BorderBrush="#2F9E6B" Margin="0"
              IsDefault="True"/>
    </StackPanel>

    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" FontFamily="Bahnschrift"/>
      <TextBlock x:Name="HintText" Opacity="0.7" Margin="0,6,0,12" TextWrapping="Wrap"
                 Text="Move a control to add it. You can add multiple inputs from any device."/>

      <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="4">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Sources" Opacity="0.65" FontSize="12" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Remove selected" Click="RemoveSelected_Click"
                    Padding="10,4" Margin="0" FontSize="12"
                    ToolTip="Remove the selected source from this binding"/>
          </DockPanel>
          <ListBox x:Name="SourcesList" Height="120" DisplayMemberPath="Display"/>
        </DockPanel>
      </Border>

      <TextBlock x:Name="ListeningText" Margin="0,8,0,0" Opacity="0.75" FontSize="12"
                 Text="Listening for another input…"/>

      <CheckBox x:Name="InvertCheck" Content="Invert axis / value"
                ToolTip="Reverse the axis or toggle sense for this binding only"/>

      <StackPanel x:Name="DeadzonePanel" Margin="0,12,0,0" Visibility="Collapsed">
        <DockPanel>
          <TextBlock x:Name="DeadzoneLabelText" Text="Deadzone" VerticalAlignment="Center"/>
          <TextBlock x:Name="DeadzoneValueText" DockPanel.Dock="Right" Width="40"
                     Text="0%" VerticalAlignment="Center" HorizontalAlignment="Right"/>
          <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="0.5" Value="0"
                  TickFrequency="0.01" IsSnapToTickEnabled="False" Margin="12,0"
                  ToolTip="Ignore small axis movement near rest, then rescale the rest of the throw"
                  ValueChanged="DeadzoneSlider_ValueChanged"/>
        </DockPanel>
        <TextBlock x:Name="DeadzoneHintText" Opacity="0.55" FontSize="11" Margin="0,4,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Text="Axis→button: pressed when the axis is at or above this threshold (use Invert for rest-high axes)."/>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
