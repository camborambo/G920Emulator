<Window x:Class="G920Emulator.App.CustomBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom binding"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="460" Width="520"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="#1A1F29"/>
        <Setter Property="Foreground" Value="#E8EAED"/>
        <Setter Property="BorderBrush" Value="#2A3140"/>
        <Setter Property="CaretBrush" Value="#E8EAED"/>
        <Setter Property="Padding" Value="8,6"/>
      </Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitchCheckBox}">
        <Setter Property="Margin" Value="0,10,0,0"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource AppButton}" Content="Cancel" Click="Cancel_Click"/>
      <Button Style="{StaticResource PrimaryButton}" Content="OK" Click="Ok_Click" Margin="0" IsDefault="True"/>
    </StackPanel>

    <StackPanel>
      <TextBlock Text="Custom binding" FontSize="20" FontWeight="SemiBold" FontFamily="Bahnschrift"/>
      <TextBlock Opacity="0.7" Margin="0,6,0,14" TextWrapping="Wrap"
                 Text="Pick a G920 target, Bind Button, and optionally Bind FN. Use Toggle if you want press-to-latch instead of hold."/>

      <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBox x:Name="NameBox" MaxLength="64"/>

      <TextBlock Text="G920 target" FontWeight="SemiBold" Margin="0,14,0,4"/>
      <ComboBox x:Name="TargetCombo" DisplayMemberPath="Label"/>

      <CheckBox x:Name="ToggleCheck" Content="Toggle"
                ToolTip="On: press latches the G920 button until pressed again. Off: hold-to-press (momentary)."/>

      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AppButton}" Content="Bind FN"
                Click="BindFn_Click" Padding="10,8"
                ToolTip="Optional. Capture the hold key for this combo."/>
        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource AppButton}" Content="Bind Button"
                Click="BindButton_Click" Margin="0" Padding="10,8"
                ToolTip="Capture the input that drives the G920 target."/>

        <TextBlock x:Name="FnSummaryText" Grid.Row="1" Grid.Column="0"
                   Opacity="0.75" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="(optional — not bound)"/>
        <TextBlock x:Name="ButtonSummaryText" Grid.Row="1" Grid.Column="2"
                   Opacity="0.75" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="(not bound)"/>

        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource AppButton}" Content="Clear FN"
                Click="ClearFn_Click" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Left"
                ToolTip="Remove the FN hold key from this binding"/>
        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource AppButton}" Content="Clear Button"
                Click="ClearButton_Click" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Left"
                ToolTip="Remove the button sources"/>
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
