<Window x:Class="G920Emulator.App.DependenciesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dependencies"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="900" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource AppButton}" Content="Recheck" Width="110" Click="Recheck_Click" Margin="0,0,10,0"/>
        <Button Style="{StaticResource AppButton}" Content="Close" Width="110" Click="Close_Click" Margin="0"/>
      </StackPanel>
      <TextBlock x:Name="FooterText" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap"
                 Margin="0,0,16,0"/>
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Dependencies" FontSize="24" FontWeight="SemiBold" FontFamily="Bahnschrift"/>
      <TextBlock Margin="0,4,0,16" Opacity="0.7" TextWrapping="Wrap"
                 Text="Set these up once. Install WinUHid (uses test signing only for that install, then turns it off), configure HidHide, then Start bridge. Forza Horizon 6 can run with WinUHid installed while test signing stays off."/>

      <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="16" CornerRadius="6" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="1. Windows test signing" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border x:Name="TestSigningRequiredBadge" Background="#6F3A1F" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="TestSigningRequiredText" Text="FOR INSTALL" FontSize="11" FontWeight="Bold"/>
            </Border>
            <Border x:Name="TestSigningStatusBadge" CornerRadius="3" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="TestSigningStatusText" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <Border x:Name="SecureBootBadge" CornerRadius="3" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="SecureBootBadgeText" FontSize="12" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="TestSigningHint" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85"/>
          <TextBlock x:Name="TestSigningDetail" Visibility="Collapsed"/>
          <WrapPanel Margin="0,14,0,-8">
            <Button x:Name="EnableTestSigningButton" Style="{StaticResource PrimaryWrapButton}"
                    Click="EnableTestSigning_Click"
                    Content="Enable test signing"
                    ToolTip="Turns on Windows test signing. Secure Boot must be off."/>
            <Button x:Name="DisableTestSigningButton" Style="{StaticResource AccentWrapButton}"
                    Click="DisableTestSigning_Click"
                    Content="Disable test signing"
                    ToolTip="Turns off Windows test signing. Reboot required."/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="16" CornerRadius="6" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="2. WinUHid" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border x:Name="WinUHidRequiredBadge" Background="#6F3A1F" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="REQUIRED" FontSize="11" FontWeight="Bold"/>
            </Border>
            <Border x:Name="WinUHidStatusBadge" CornerRadius="3" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="WinUHidStatusText" FontSize="12" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="WinUHidHint" Margin="0,10,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="WinUHidDetail" Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,14,0,-8">
            <Button x:Name="InstallWinUHidButton" Style="{StaticResource PrimaryWrapButton}" Click="SetupWinUHid_Click"
                    Content="Install WinUHid"
                    ToolTip="Install bundled WinUHid: enable test signing if needed, install driver, then turn test signing off (Forza-friendly)"/>
            <Button x:Name="UninstallWinUHidButton" Style="{StaticResource AccentWrapButton}" Click="UninstallWinUHid_Click"
                    Content="Uninstall WinUHid"
                    ToolTip="Remove WinUHid and turn off Windows test signing"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="16" CornerRadius="6" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="3. HidHide" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Background="#6F3A1F" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="REQUIRED" FontSize="11" FontWeight="Bold"/>
            </Border>
            <Border x:Name="HidHideStatusBadge" CornerRadius="3" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="HidHideStatusText" FontSize="12" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="HidHideHint" Margin="0,10,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="HidHideDetail" Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,14,0,-8">
            <Button Style="{StaticResource PrimaryWrapButton}" Click="ConfigureHidHide_Click"
                    Content="Configure HidHide"
                    ToolTip="Optional helper: whitelist this app, inverse off, cloak on, hide Gaming-list devices (virtual G920 stays visible). One-shot setup - same idea as Settings → HidHide → Hide all (except emulator). Use Save &amp; restore on Stop there if you want your prior config back."/>
            <Button Style="{StaticResource AccentWrapButton}" Content="Download HidHide…"
                    Click="DownloadHidHide_Click"/>
            <Button Style="{StaticResource WrapButton}" Content="Open HidHide Client" Click="OpenHidHideClient_Click"/>
            <Button Style="{StaticResource WrapButton}" Content="Open HidHide docs" Click="OpenHidHideDocs_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="16" CornerRadius="6" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="OEM / Logitech SDK" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border x:Name="OemSdkStatusBadge" CornerRadius="3" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="OemSdkStatusText" FontSize="12" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85"
                     Text="Pinned automatically on Start bridge for NFS Heat / Unbound-style games; restored on Stop, app close, or next launch after a crash. No setup needed."/>
          <TextBlock x:Name="OemSdkDetail" Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,14,0,-8">
            <Button x:Name="RestoreOemSdkButton" Style="{StaticResource AccentWrapButton}"
                    Content="Restore system registration"
                    Click="RestoreOemSdk_Click"
                    ToolTip="Clear leftover OEM/SDK pins if a previous session did not restore cleanly. Stop the bridge first."/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="16" CornerRadius="6" Margin="0,0,0,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="G HUB guard" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border x:Name="GHubGuardBadge" CornerRadius="3" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="GHubGuardStatusText" FontSize="12" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85"
                     Text="While the bridge is running, the guard keeps the virtual G920 identity intact if G HUB rewrites it. It does not run while the bridge is stopped."/>
          <TextBlock x:Name="GHubGuardDetail" Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,14,0,-8">
            <Button Style="{StaticResource AccentWrapButton}" Content="Repair G HUB leftovers"
                    Click="RepairGHub_Click"
                    ToolTip="Clears Logitech HID filters on the G920 VID/PID and stale DirectInput cache."/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="16" CornerRadius="6">
        <StackPanel>
          <TextBlock Text="Full clean restore (optional)" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85"
                     Text="Nuclear option: clears app leftovers, WinUHid, and turns off test signing. Not required for Forza - prefer Disable test signing if it was left on."/>
          <WrapPanel Margin="0,14,0,-8">
            <Button x:Name="FullCleanRestoreButton" Style="{StaticResource AccentWrapButton}"
                    Content="Full clean restore…"
                    Click="FullCleanRestore_Click"
                    ToolTip="Optional full wipe of app system changes. For Forza splash exit, use Disable test signing or Uninstall WinUHid instead."/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
