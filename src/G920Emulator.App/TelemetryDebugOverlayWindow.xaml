<Window x:Class="G920Emulator.App.TelemetryDebugOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Telemetry Debug Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Width="420" Height="720"
        MinWidth="380" MinHeight="560"
        FontFamily="Segoe UI"
        Foreground="#E8EAED">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="#E0121418" BorderBrush="#5A3A4254" BorderThickness="1" CornerRadius="10"
          MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
    <DockPanel Margin="12">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Close_Click"
                ToolTip="Close overlay">
          <iconPacks:PackIconMaterial Kind="Close" Width="12" Height="12" Foreground="#E8EAED"/>
        </Button>
        <TextBlock Text="Telemetry Debug Overlay" FontWeight="SemiBold" FontSize="14" FontFamily="Bahnschrift"
                   VerticalAlignment="Center"/>
      </DockPanel>

      <Border DockPanel.Dock="Top" Background="#222836" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
        <DockPanel>
          <TextBlock x:Name="SessionText" DockPanel.Dock="Right" Text="session -" FontSize="12"
                     VerticalAlignment="Center" Opacity="0.9" Margin="10,0,0,0"/>
          <TextBlock x:Name="GearText" Text="GEAR N" FontWeight="Bold" FontFamily="Bahnschrift"
                     FontSize="18" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Text="Telemetry: -" FontSize="12"
                 Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,10"/>

      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <TextBlock x:Name="SpeedText" Text="Speed: 0" FontSize="12" Opacity="0.9"/>
        <ProgressBar x:Name="SpeedBar" Height="8" Minimum="0" Maximum="350" Value="0" Margin="0,3,0,8"
                     Foreground="#2A9D8F"/>
        <TextBlock x:Name="RpmText" Text="RPM: 0" FontSize="12" Opacity="0.9"/>
        <ProgressBar x:Name="RpmBar" Height="8" Minimum="0" Maximum="8000" Value="0" Margin="0,3,0,8"
                     Foreground="#C9A227"/>
        <TextBlock x:Name="EngineVibText" Text="Engine vibration: 0%" FontSize="12" Opacity="0.9"/>
        <ProgressBar x:Name="EngineVibBar" Height="8" Minimum="0" Maximum="1" Value="0" Margin="0,3,0,8"
                     Foreground="#C97B27"/>
        <TextBlock x:Name="SteerText" Text="Steering: 0.00" FontSize="12" Opacity="0.9"/>
        <ProgressBar x:Name="SteerBar" Height="8" Minimum="-1" Maximum="1" Value="0" Margin="0,3,0,8"
                     Foreground="#5B7C99"/>
        <TextBlock x:Name="ThrottleText" Text="Throttle: 0%" FontSize="12" Opacity="0.9"/>
        <ProgressBar x:Name="ThrottleBar" Height="8" Minimum="0" Maximum="1" Value="0" Margin="0,3,0,8"
                     Foreground="#1F6F4A"/>
        <TextBlock x:Name="BrakeText" Text="Brake: 0%" FontSize="12" Opacity="0.9"/>
        <ProgressBar x:Name="BrakeBar" Height="8" Minimum="0" Maximum="1" Value="0" Margin="0,3,0,8"
                     Foreground="#B33A3A"/>
        <TextBlock x:Name="ClutchText" Text="Clutch: 0%" FontSize="12" Opacity="0.9"/>
        <ProgressBar x:Name="ClutchBar" Height="8" Minimum="0" Maximum="1" Value="0" Margin="0,3,0,0"
                     Foreground="#8B7355"/>
      </StackPanel>

      <TextBlock DockPanel.Dock="Top" Text="Packet" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <TextBlock x:Name="PacketText" FontFamily="Consolas" FontSize="12"
                   TextWrapping="NoWrap" Opacity="0.9"
                   Text="Live SimHub UDP fields will appear here."/>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
