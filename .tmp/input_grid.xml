<Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1.25*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Detected devices" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Style="{StaticResource AppButton}" Content="Refresh" Click="RefreshButton_Click" Padding="10,5"
                          ToolTip="Re-scan DirectInput devices and restore any you hid with Remove"/>
                  <Button Style="{StaticResource AppButton}" Content="Remove" Click="RemoveDevice_Click" Margin="0" Padding="10,5"
                          ToolTip="Hide the selected device from this list. Refresh to show it again."/>
                </StackPanel>
              </DockPanel>
              <TextBlock DockPanel.Dock="Bottom" x:Name="BindHintText"
                         Text="Click a G920 binding to Assign. Buttons also accept axes (axis→button)."
                         Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
              <ListBox x:Name="DeviceList" DisplayMemberPath="Display" BorderThickness="0" Background="Transparent"/>
            </DockPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="10">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="G920 bindings" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource AppButton}" Content="Clear all" Click="ClearAllBindings_Click"
                        Margin="0" HorizontalAlignment="Right" Padding="10,5"
                        ToolTip="Clear every G920 binding in this profile"/>
              </DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock Text="Shifter mode" Opacity="0.7" Margin="0,0,0,4" FontSize="12"
                           ToolTip="Exclusive H-pattern (default): only one gear bit is on at a time — like a real H-gate. If more than one gear is pressed, keeps the first match (R→1→6) and clears the rest. Passthrough: every gear binding is forwarded as-is, so multiple gear bits can be on together."/>
                <ComboBox x:Name="ShifterModeCombo" SelectionChanged="ShifterModeCombo_SelectionChanged"
                          ToolTip="Exclusive H-pattern (default): only one gear bit is on at a time — like a real H-gate. If more than one gear is pressed, keeps the first match (R→1→6) and clears the rest. Passthrough: every gear binding is forwarded as-is, so multiple gear bits can be on together.">
                  <ComboBoxItem Content="Exclusive H-pattern" Tag="ExclusiveHPattern" IsSelected="True"/>
                  <ComboBoxItem Content="Passthrough" Tag="Passthrough"/>
                </ComboBox>
              </StackPanel>
              <ListBox x:Name="BindingList" MouseLeftButtonUp="BindingList_MouseLeftButtonUp"
                       BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="120"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding SourceText}" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                      <DockPanel Margin="0,6,0,0" Visibility="{Binding DeadzoneVisibility}">
                        <TextBlock Text="{Binding DeadzoneLabel}" Width="72" Opacity="0.7" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DeadzoneText}" Width="36"
                                   Opacity="0.85" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                        <Slider Minimum="{Binding DeadzoneMinimum}" Maximum="{Binding DeadzoneMaximum}"
                                TickFrequency="0.01" IsSnapToTickEnabled="False"
                                Value="{Binding Deadzone, Mode=TwoWay}"
                                Margin="8,0"
                                ToolTip="{Binding DeadzoneToolTip}"
                                PreviewMouseLeftButtonDown="DeadzoneSlider_PreviewMouseLeftButtonDown"/>
                      </DockPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Live virtual G920" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
              <TextBlock x:Name="ButtonsText" Text="Buttons: —" FontSize="13" MinHeight="40"
                         TextWrapping="Wrap" Opacity="0.95"
                         ToolTip="Pressed virtual G920 buttons while the bridge is running"/>
            </StackPanel>
          </Border>
        </Grid>