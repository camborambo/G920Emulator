<Window x:Class="G920Emulator.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="520" Width="600"
        MinHeight="460" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Same pill chrome as MainTabRadio, left-aligned for a vertical nav well. -->
      <Style x:Key="SettingsTabRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                      BorderThickness="1" Padding="{TemplateBinding Padding}"
                      CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#1A1F29"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgWell}"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Background" Value="#2A3140"/>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#E8EAED"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
      </Style>
      <Style TargetType="RadioButton" x:Key="HidHideModeRadio">
        <Setter Property="Foreground" Value="#E8EAED"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20">
    <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="20" FontWeight="SemiBold"
               FontFamily="Bahnschrift" Margin="0,0,0,14"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="Close" Width="110"
              IsDefault="True" IsCancel="True" Click="Close_Click" Margin="0"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="168"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Same well + pill pattern as the main window tab strip -->
      <Border Grid.Column="0" Background="#0E1116" BorderBrush="{StaticResource BorderSubtle}"
              BorderThickness="1" CornerRadius="10" Padding="4" VerticalAlignment="Top">
        <StackPanel>
          <RadioButton x:Name="GeneralTab" Style="{StaticResource SettingsTabRadio}" GroupName="SettingsTabs"
                       IsChecked="True" Checked="SettingsTab_Checked">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="CogOutline" Width="14" Height="14"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="General" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="OverlaysTab" Style="{StaticResource SettingsTabRadio}" GroupName="SettingsTabs"
                       Checked="SettingsTab_Checked">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="MonitorScreenshot" Width="14" Height="14"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Overlays" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="HidHideTab" Style="{StaticResource SettingsTabRadio}" GroupName="SettingsTabs"
                       Checked="SettingsTab_Checked">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="EyeOffOutline" Width="14" Height="14"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="HidHide" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="DebugTestTab" Style="{StaticResource SettingsTabRadio}" GroupName="SettingsTabs"
                       Margin="0" Checked="SettingsTab_Checked">
            <StackPanel Orientation="Horizontal">
              <iconPacks:PackIconMaterial Kind="FlaskOutline" Width="14" Height="14"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Debug Test" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1"
              CornerRadius="8" Padding="18">
        <Grid>
          <!-- General -->
          <StackPanel x:Name="GeneralPanel">
            <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize to system tray"
                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                      ToolTip="When on, minimizing hides the window in the notification area. The close button still quits."/>
            <CheckBox x:Name="CheckForUpdatesCheck" Content="Check for GitHub updates"
                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                      ToolTip="At launch, ask GitHub if a newer release is published. Off means no network check."/>
            <CheckBox x:Name="TelemetryKmhCheck" Content="Telemetry km/h"
                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                      ToolTip="Off (default): show MPH / MPH/s. On: show km/h / km/h/s. SimHub always receives km/h."/>
            <Button Style="{StaticResource AppButton}" Content="Manage dependencies…"
                    HorizontalAlignment="Left" Margin="0,4,0,0" Click="Dependencies_Click"
                    ToolTip="Install, uninstall, or recheck WinUHid, HidHide, and test signing."/>
          </StackPanel>

          <!-- Overlays -->
          <StackPanel x:Name="OverlaysPanel" Visibility="Collapsed">
            <CheckBox x:Name="FfbDebugOverlayCheck" Content="FFB Debug Overlay"
                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                      ToolTip="Show a topmost overlay with live G920 inputs and FFB diagnostics while you drive."/>
            <CheckBox x:Name="TelemetryDebugOverlayCheck" Content="Telemetry Debug Overlay"
                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                      ToolTip="Show a topmost overlay with the live SimHub telemetry packet being sent."/>
            <CheckBox x:Name="EffectChangesOverlayCheck" Content="Effect Changes Overlay"
                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                      ToolTip="Flash the effect name and gain percent at the top of the screen when you press FFB bind buttons."/>
          </StackPanel>

          <!-- HidHide -->
          <StackPanel x:Name="HidHidePanel" Visibility="Collapsed">
            <TextBlock Text="On Start" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <RadioButton x:Name="HidHideOffRadio" Style="{StaticResource HidHideModeRadio}" GroupName="HidHideMode"
                         Content="Off — leave HidHide alone"
                         Checked="HidHideMode_Changed"
                         ToolTip="Start never changes HidHide. Configure it yourself in HidHide Client."/>
            <RadioButton x:Name="HidHideAllRadio" Style="{StaticResource HidHideModeRadio}" GroupName="HidHideMode"
                         Content="Hide all (except emulator)"
                         Checked="HidHideMode_Changed"
                         ToolTip="Whitelist this app and hide every device on HidHide’s Gaming list. Virtual G920 stays visible."/>
            <RadioButton x:Name="HidHideBoundRadio" Style="{StaticResource HidHideModeRadio}" GroupName="HidHideMode"
                         Content="Hide bound devices only"
                         Checked="HidHideMode_Changed"
                         ToolTip="Hide only devices used in your current bindings (and FFB source). Other pads stay visible for in-game binding."/>
            <CheckBox x:Name="HidHideRestoreCheck" Content="Save &amp; restore on Stop"
                      Margin="0,8,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"
                      ToolTip="With an apply mode on: Start can save your current HidHide setup and put it back on Stop/Exit."/>
            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Close HidHide Client before Start (it locks the driver). Windows may ask for admin permission."/>
          </StackPanel>

          <!-- Debug Test (experimental FFB/input A/B) -->
          <ScrollViewer x:Name="DebugTestPanel" Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                         Text="Enable only reveals these knobs. Defaults match the last stable release — turning Enable on by itself does not change FFB/input. Change a sub-option only to A/B a freeze fix."/>
              <CheckBox x:Name="FfbExperimentalCheck" Content="Enable Debug Test (Experimental)"
                        Checked="FfbExperimental_Changed" Unchecked="FfbExperimental_Changed"
                        ToolTip="Shows the options below. With defaults selected, behavior matches the normal (non-debug) path."/>
              <StackPanel x:Name="FfbExperimentalOptions" Margin="4,4,0,0" Visibility="Collapsed">
                <TextBlock Text="Cooperative level" FontWeight="SemiBold" Margin="0,8,0,8"/>
                <RadioButton x:Name="FfbExclusiveRadio" Style="{StaticResource HidHideModeRadio}" GroupName="FfbCoop"
                             Content="Exclusive — strongest FFB"
                             Checked="FfbCoop_Changed"
                             ToolTip="Normal/release path. Emulator claims the base for force feedback."/>
                <RadioButton x:Name="FfbNonExclusiveRadio" Style="{StaticResource HidHideModeRadio}" GroupName="FfbCoop"
                             Content="NonExclusive — shared acquire"
                             Checked="FfbCoop_Changed"
                             ToolTip="A/B only: try if Exclusive freezes steer/pedals on the FFB base."/>
                <TextBlock Text="Input / FFB mitigations" FontWeight="SemiBold" Margin="0,12,0,8"/>
                <CheckBox x:Name="FfbDualHandleInputCheck" Content="Dual-handle input"
                          Checked="FfbDualHandle_Changed" Unchecked="FfbDualHandle_Changed"
                          ToolTip="Off = normal/release (Exclusive FFB shares InputHub; input overlaid from that handle). On = A/B standalone Exclusive FFB + InputHub keeps NonExclusive Poll — for mid-race dead inputs while forces stay Exclusive."/>
                <CheckBox x:Name="FfbUnlockedSetParametersCheck" Content="Unlocked SetParameters"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Off = normal/release (SetParameters under the DI lock). On = A/B unlock so Poll can run during apply."/>
                <CheckBox x:Name="FfbNonBlockingRimReadsCheck" Content="Non-blocking rim reads"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="Off = normal/release (TryEnter 0 + cache). On = A/B brief wait when cache is stale."/>
                <CheckBox x:Name="FfbSoftCatchUpSteerCheck" Content="Soft steering catch-up"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"
                          ToolTip="On = normal/release (limits per-frame steering jumps). Uncheck to A/B without the limiter."/>
                <Button Style="{StaticResource AppButton}" Content="Default"
                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="FfbExperimentalDefault_Click"
                        ToolTip="Turn Debug Test off and restore release defaults (Exclusive, dual-handle off, locked SetParameters, soft catch-up on)."/>
                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Re-attaches FFB when Enable, cooperative level, or Dual-handle input changes."/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
