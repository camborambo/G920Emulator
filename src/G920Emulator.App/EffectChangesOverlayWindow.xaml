<Window x:Class="G920Emulator.App.EffectChangesOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Effect Changes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        FontFamily="Bahnschrift"
        Foreground="#F2F4F7">
  <Border Background="#A3101218" CornerRadius="10" Padding="28,14,28,14"
          BorderBrush="#55FFFFFF" BorderThickness="1" MinWidth="220">
    <StackPanel>
      <TextBlock x:Name="CategoryText" Text="EFFECT GAINS" FontSize="11" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Opacity="0.5"/>
      <TextBlock x:Name="NameText" Text="Spring" FontSize="18" FontWeight="SemiBold"
                 HorizontalAlignment="Center" Margin="0,4,0,0"/>
      <TextBlock x:Name="PercentText" Text="100%" FontSize="40" FontWeight="Bold"
                 HorizontalAlignment="Center" Margin="0,2,0,0"/>
    </StackPanel>
  </Border>
</Window>
