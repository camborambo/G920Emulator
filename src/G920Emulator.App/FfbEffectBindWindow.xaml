<Window x:Class="G920Emulator.App.FfbEffectBindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bind effect buttons"
        Icon="pack://application:,,,/Assets/app.ico"
        SizeToContent="Height"
        Width="460"
        MinHeight="360"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="20">
    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="Done"
            HorizontalAlignment="Right" Margin="0,16,0,0" IsDefault="True" Click="Done_Click"/>

    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" FontFamily="Bahnschrift"/>
      <TextBlock Opacity="0.7" Margin="0,6,0,16" TextWrapping="Wrap"
                 Text="Assign hardware buttons that lower or raise this effect gain by 5% while you drive. These binds are saved on the input profile."/>

      <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource AppButton}" Content="Assign"
                  MinWidth="72" Click="AssignMinus_Click"/>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Lower (−)" FontWeight="SemiBold"/>
            <TextBlock x:Name="MinusBindingText" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Not bound"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="6">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource AppButton}" Content="Assign"
                  MinWidth="72" Click="AssignPlus_Click"/>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Raise (+)" FontWeight="SemiBold"/>
            <TextBlock x:Name="PlusBindingText" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Not bound"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
