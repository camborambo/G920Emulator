<Project>
  <!-- Bump Version here for a release. All src projects inherit it. -->
  <PropertyGroup>
    <Version>0.2.7</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Steering Wheel Emulator</Product>
    <Company>Steering Wheel Emulator</Company>
  </PropertyGroup>
</Project>
