<Window x:Class="G920Emulator.App.WinUHidSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install WinUHid"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="600" Width="640"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Button x:Name="InstallButton"
              Height="48"
              Style="{StaticResource PrimaryButton}"
              Click="Install_Click"
              HorizontalAlignment="Stretch"
              Margin="0,0,0,10"
              Content="Install WinUHid"
              FontSize="15"
              ToolTip="Install the bundled WinUHid driver"/>
      <Button x:Name="UninstallButton"
              Height="40"
              Style="{StaticResource AccentButton}"
              Click="Uninstall_Click"
              HorizontalAlignment="Stretch"
              Margin="0,0,0,10"
              Content="Uninstall WinUHid"
              FontSize="14"
              ToolTip="Remove WinUHid and turn off Windows test signing (reboot required for Forza Horizon 6)"/>
      <TextBlock Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12"
                 Text="Install enables test signing only if needed, registers WinUHid, then turns test signing back off (Forza-friendly). You may need one reboot to enter test mode, then Install again to finish. Uninstall removes the driver. Approve UAC prompts."/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource AppButton}" Content="Close" Width="110" Click="Close_Click" Margin="0"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource AppButton}" Content="Recheck" Width="110" Click="Recheck_Click" Margin="0,0,10,0"/>
        <TextBlock x:Name="FooterText" Opacity="0.65" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Install WinUHid" FontSize="24" FontWeight="SemiBold" FontFamily="Bahnschrift"/>
        <TextBlock Opacity="0.7" Margin="0,4,0,16" TextWrapping="Wrap"
                   Text="Required so games can see the virtual Logitech G920. Everything needed is bundled with G920 Emulator - no download."/>

        <Border Background="#3A2A14" BorderBrush="#8A5A1F" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Forza-friendly install" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.9"
                       Text="Test signing is only required to install the test-signed WinUHid driver. Install turns it on (if needed), installs the driver, then turns it off again. Secure Boot must be off in UEFI/BIOS for the install step only - after WinUHid is installed and test signing is off, you can re-enable Secure Boot. Forza Horizon 6 and the emulator keep working."/>
          </StackPanel>
        </Border>

        <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="StatusSummary" Text="Checking…" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusDetail" Opacity="0.65" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="6">
          <StackPanel>
            <TextBlock Text="Bundled package" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="PackageText" Opacity="0.85" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
