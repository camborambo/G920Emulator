<Window x:Class="G920Emulator.App.WinUHidSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install WinUHid"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="520" Width="640"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">
  <DockPanel Margin="20">
    <!-- Primary actions always visible at bottom -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Button x:Name="InstallButton"
              Height="48"
              Background="#1F6F4A"
              BorderBrush="#2F9E6B"
              Click="Install_Click"
              HorizontalAlignment="Stretch"
              Margin="0,0,0,10"
              ToolTip="Install the bundled WinUHid driver">
        <TextBlock Text="Install WinUHid"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF"
                   HorizontalAlignment="Center"/>
      </Button>
      <TextBlock Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12"
                 Text="Copies WinUHid.dll, enables test signing if needed (reboot once), registers the driver, and creates the Root\WinUHid device (works even when pnputil /add-device is missing). Approve UAC prompts."/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Close" Width="100" Click="Close_Click" Margin="0"/>
        <Button DockPanel.Dock="Right" Content="Recheck" Width="100" Click="Recheck_Click" Margin="0,0,8,0"/>
        <TextBlock x:Name="FooterText" Opacity="0.65" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Install WinUHid" FontSize="24" FontWeight="SemiBold" FontFamily="Bahnschrift"/>
        <TextBlock Opacity="0.7" Margin="0,4,0,16" TextWrapping="Wrap"
                   Text="Required so games can see the virtual Logitech G920. Everything needed is bundled with G920 Emulator — no download."/>

        <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="StatusSummary" Text="Checking…" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusDetail" Opacity="0.65" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="4">
          <StackPanel>
            <TextBlock Text="Bundled package" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock x:Name="PackageText" Opacity="0.85" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
