<Window x:Class="G920Emulator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="G920 Emulator"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="760" Width="1140"
        MinHeight="640" MinWidth="960"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#1A1F29"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="Foreground" Value="#E8EAED"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1A1F29"/>
      <Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="CaretBrush" Value="#E8EAED"/>
    </Style>
    <!-- Force dark popup chrome; default ComboBox uses system Window brush (white) with our light text. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1A1F29"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8EAED"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2A4554"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E8EAED"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1F29"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E8EAED"/>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#232A36"/>
      <Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="BorderBrush" Value="#3A4458"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="MaxWidth" Value="380"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#1A1F29"/>
      <Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A4554"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#888888"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="28"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Border" Grid.ColumnSpan="2"
                Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="2"/>
        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="M 0 0 L 6 6 L 12 0" Stroke="#E8EAED" StrokeThickness="1.5"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Border" Property="Background" Value="#222836"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Border" Property="Background" Value="#222836"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#1A1F29"/>
      <Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Template="{StaticResource ComboBoxToggleButton}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press"/>
              <ContentPresenter x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Margin="8,5,32,5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                TextElement.Foreground="#E8EAED"/>
              <Popup x:Name="Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Slide">
                <Grid x:Name="DropDown"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      SnapsToDevicePixels="True">
                  <Border x:Name="DropDownBorder"
                          Background="#1A1F29"
                          BorderBrush="#2A3140"
                          BorderThickness="1"/>
                  <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Grid>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#888888"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
        <Button x:Name="StartButton" Content="Start bridge" Click="StartButton_Click"
                Style="{StaticResource PrimaryButton}"/>
        <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False"
                Style="{StaticResource DangerButton}" Margin="0"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="G920 Emulator" FontSize="28" FontWeight="SemiBold" FontFamily="Bahnschrift"/>
        <TextBlock Text="Forward any wheel, pedals, and H-shifter into a virtual Logitech G920" Opacity="0.7" Margin="0,2,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- Profile bar -->
    <Border DockPanel.Dock="Top" Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Input profile" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                   ToolTip="Bindings / devices. Force feedback has its own profiles below."/>
        <TextBox x:Name="ProfileNameBox" Grid.Column="1" VerticalAlignment="Center" ToolTip="Input profile name"/>
        <TextBlock Grid.Column="3" Text="Saved" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="SavedProfilesCombo" Grid.Column="4" VerticalAlignment="Center" SelectionChanged="SavedProfilesCombo_SelectionChanged"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource AppButton}" Content="Save" Click="SaveButton_Click" ToolTip="Save input profile to AppData"/>
          <Button Style="{StaticResource AppButton}" Content="Save As…" Click="SaveAsButton_Click"/>
          <Button Style="{StaticResource AppButton}" Content="Delete" Click="DeleteProfileButton_Click"/>
          <Button Style="{StaticResource AppButton}" Content="Export…" Click="ExportButton_Click"/>
          <Button Style="{StaticResource AppButton}" Content="Import…" Click="ImportButton_Click" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Dependencies status -->
    <Border x:Name="DependenciesBanner" DockPanel.Dock="Top" Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource AppButton}" Content="Recheck" Click="RecheckDependencies_Click"/>
          <Button x:Name="DependenciesActionButton" Content="Manage dependencies…" Click="DependenciesButton_Click"
                  Style="{StaticResource AccentButton}" Margin="0"/>
        </StackPanel>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Dependencies" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Border x:Name="WinUHidChip" CornerRadius="4" Padding="10,5" Margin="0,0,8,0">
              <TextBlock x:Name="WinUHidChipText" FontWeight="SemiBold"/>
            </Border>
            <Border x:Name="HidHideChip" CornerRadius="4" Padding="10,5" Margin="0,0,8,0">
              <TextBlock x:Name="HidHideChipText" FontWeight="SemiBold"/>
            </Border>
            <Border x:Name="LogiSdkChip" CornerRadius="4" Padding="10,5">
              <TextBlock x:Name="LogiSdkChipText" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="DependenciesSummaryText" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#0E1116" Foreground="#AAB0BB" Margin="0,12,0,0">
      <StatusBar.ItemsPanel>
        <ItemsPanelTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
          </Grid>
        </ItemsPanelTemplate>
      </StatusBar.ItemsPanel>
      <StatusBarItem Grid.Column="0">
        <TextBlock x:Name="StatusText" Text="Ready"/>
      </StatusBarItem>
      <StatusBarItem Grid.Column="1" HorizontalAlignment="Right" Padding="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.7">
            <Run Text="by " Foreground="#AAB0BB"/>
            <Hyperlink NavigateUri="https://stachenscale.com/" RequestNavigate="AuthorLink_RequestNavigate"
                       Foreground="#8AB4F8" TextDecorations="None">CamboRambo</Hyperlink>
          </TextBlock>
          <Button x:Name="DebugSessionButton" Style="{StaticResource AppButton}" Content="Debug"
                  Padding="10,4" Margin="0,0,6,0" FontSize="12"
                  Click="DebugSessionButton_Click"
                  ToolTip="Start a debug session to capture OEM / HID++ logs. Stop when done, then Export log."/>
          <Button x:Name="ExportDebugLogButton" Style="{StaticResource AppButton}" Content="Export log…"
                  Padding="10,4" Margin="0,0,6,0" FontSize="12" IsEnabled="False"
                  Click="ExportDebugLogButton_Click"
                  ToolTip="Export diagnostics after you stop a Debug session"/>
          <Button Style="{StaticResource AppButton}" Content="About" Padding="10,4" Margin="0"
                  FontSize="12" Click="AboutButton_Click" ToolTip="Credits and disclaimer"/>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="1.2*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="0.9*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="Detected devices" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource AppButton}" Content="Refresh" Click="RefreshButton_Click"
                    ToolTip="Re-scan DirectInput devices and restore any you hid with Remove"/>
            <Button Style="{StaticResource AppButton}" Content="Remove" Click="RemoveDevice_Click" Margin="0"
                    ToolTip="Hide the selected device from this list. Refresh to show it again."/>
          </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="BindHintText"
                   Text="Click a G920 binding to capture inputs. Buttons also accept axes (axis→button)."
                   Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <ListBox x:Name="DeviceList" DisplayMemberPath="Display"/>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="G920 bindings" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource AppButton}" Content="Clear all" Click="ClearAllBindings_Click"
                  Margin="0" HorizontalAlignment="Right"
                  ToolTip="Clear every G920 binding in this profile"/>
        </DockPanel>
        <ListBox x:Name="BindingList" MouseLeftButtonUp="BindingList_MouseLeftButtonUp">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,6"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding SourceText}" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <DockPanel Margin="0,6,0,0" Visibility="{Binding DeadzoneVisibility}">
                  <TextBlock Text="{Binding DeadzoneLabel}" Width="72" Opacity="0.7" VerticalAlignment="Center" FontSize="12"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding DeadzoneText}" Width="36"
                             Opacity="0.85" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                  <Slider Minimum="{Binding DeadzoneMinimum}" Maximum="{Binding DeadzoneMaximum}"
                          TickFrequency="0.01" IsSnapToTickEnabled="False"
                          Value="{Binding Deadzone, Mode=TwoWay}"
                          Margin="8,0"
                          ToolTip="{Binding DeadzoneToolTip}"
                          PreviewMouseLeftButtonDown="DeadzoneSlider_PreviewMouseLeftButtonDown"/>
                </DockPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Live virtual G920" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="4">
            <StackPanel>
              <TextBlock x:Name="GearText" Text="Gear: N" FontSize="22" FontWeight="Bold" FontFamily="Bahnschrift"/>
              <TextBlock x:Name="SteerText" Text="Steering: 0.00" Margin="0,8,0,0"/>
              <ProgressBar x:Name="SteerBar" Height="8" Minimum="-1" Maximum="1" Value="0" Margin="0,4,0,0"/>
              <TextBlock x:Name="ThrottleText" Text="Throttle: 0%" Margin="0,8,0,0"/>
              <ProgressBar x:Name="ThrottleBar" Height="8" Minimum="0" Maximum="1" Value="0" Margin="0,4,0,0"/>
              <TextBlock x:Name="BrakeText" Text="Brake: 0%" Margin="0,8,0,0"/>
              <ProgressBar x:Name="BrakeBar" Height="8" Minimum="0" Maximum="1" Value="0" Margin="0,4,0,0"/>
              <TextBlock x:Name="ClutchText" Text="Clutch: 0%" Margin="0,8,0,0"/>
              <ProgressBar x:Name="ClutchBar" Height="8" Minimum="0" Maximum="1" Value="0" Margin="0,4,0,0"/>
              <TextBlock x:Name="ButtonsText" Text="Buttons: —" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <TextBlock Text="Force feedback" FontWeight="SemiBold" Margin="0,16,0,8"/>
          <Border Background="#1A1F29" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="4">
            <StackPanel ToolTipService.ShowDuration="30000" ToolTipService.InitialShowDelay="400">
              <TextBlock Text="FFB profile" Opacity="0.7" Margin="0,0,0,4"
                         ToolTip="Saved force feedback settings (gains, output feel, torque shaping). Separate from input bindings. Raw passes the game's feedback through unchanged."/>
              <ComboBox x:Name="FfbProfilesCombo" Margin="0,0,0,6" VerticalAlignment="Center"
                        ToolTip="Pick an FFB profile. Raw passes the game's feedback through unchanged. Use Save As… to create your own per-game profiles."
                        SelectionChanged="FfbProfilesCombo_SelectionChanged"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource AppButton}" Content="Save" Click="SaveFfbButton_Click"
                        ToolTip="Save the current FFB sliders to the selected FFB profile."/>
                <Button Style="{StaticResource AppButton}" Content="Save As…" Click="SaveFfbAsButton_Click"
                        ToolTip="Save the current FFB sliders as a new FFB profile."/>
                <Button Style="{StaticResource AppButton}" Content="Delete" Click="DeleteFfbButton_Click" Margin="0"
                        ToolTip="Delete the selected FFB profile. The built-in Raw profile cannot be deleted."/>
              </StackPanel>
              <TextBlock Text="FFB output device" Opacity="0.7" Margin="0,0,0,4"
                         ToolTip="The physical wheel base that plays the force feedback (Fanatec, Simucube, Moza, …)."/>
              <ComboBox x:Name="FfbDeviceCombo" DisplayMemberPath="Display" SelectionChanged="FfbDeviceCombo_SelectionChanged"
                        ToolTip="The physical wheel base that plays the force feedback (Fanatec, Simucube, Moza, …)."/>
              <DockPanel Margin="0,10,0,0"
                         ToolTip="Overall force feedback strength, applied after all effects are mixed. 100% = the game's own strength; up to 200% boosts weak games (strong peaks may clip).">
                <TextBlock Text="Master" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="GainValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="GainSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="GainSlider_ValueChanged"/>
              </DockPanel>
              <TextBlock Text="Effect gains" Opacity="0.7" Margin="0,12,0,4"
                         ToolTip="Scale each type of effect the game sends before they are mixed. 100% = as the game sent it, 0% = mute. Most types up to 200%; Constant (tire load) up to 400%. Click a % to type an exact value."/>
              <DockPanel Margin="0,2,0,0"
                         ToolTip="Constant force (tire load): the main steering torque most games send — tyre load, self-aligning force, road surface, curb and crash hits. Up to 400% (other effect gains max at 200%).">
                <TextBlock Text="Constant" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="GainConstantValueText" DockPanel.Dock="Right" Width="48" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="GainConstantSlider" Minimum="0" Maximum="4" Value="1" TickFrequency="0.1"
                        ValueChanged="EffectGainSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Spring: pulls the wheel back toward center, harder the further you turn. Arcade games use it for self-centering and in menus. Lower it if centering feels too stiff.">
                <TextBlock Text="Spring" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="GainSpringValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="GainSpringSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                        ValueChanged="EffectGainSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Damper: resists how fast you turn the wheel (like moving through thick liquid). Adds weight and calms oscillation; too much feels sluggish.">
                <TextBlock Text="Damper" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="GainDamperValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="GainDamperSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                        ValueChanged="EffectGainSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Friction: a constant drag whenever the wheel moves, regardless of speed. Often used for tyre scrub or a heavy wheel when parked.">
                <TextBlock Text="Friction" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="GainFrictionValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="GainFrictionSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                        ValueChanged="EffectGainSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Inertia: resists changes in turning speed, so the wheel feels like it has more mass. Few games use it.">
                <TextBlock Text="Inertia" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="GainInertiaValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="GainInertiaSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                        ValueChanged="EffectGainSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Periodic: vibration effects (sine, square, triangle, sawtooth) — engine rumble, rumble strips, gravel, collisions and crash shake. Raise it if rumble feels weak, lower it if it is too buzzy.">
                <TextBlock Text="Periodic" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="GainPeriodicValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="GainPeriodicSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                        ValueChanged="EffectGainSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Ramp: a force that slides from one strength to another over time. Rarely used; some games use it for building or fading pushes.">
                <TextBlock Text="Ramp" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="GainRampValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="GainRampSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                        ValueChanged="EffectGainSlider_ValueChanged"/>
              </DockPanel>

              <TextBlock Text="Output feel" Opacity="0.7" Margin="0,12,0,4"
                         ToolTip="Optional filtering of the final mixed torque before it reaches your base. The defaults (off) leave the game's feedback exact."/>
              <DockPanel Margin="0,2,0,0"
                         ToolTip="Smoothing: filters out harsh, grainy detail (low-pass, in milliseconds). 0 = off, exact game feedback. Try 8–15 ms on direct-drive bases that feel notchy. Higher values add a little delay and soften detail.">
                <TextBlock Text="Smoothing" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeelSmoothingValueText" DockPanel.Dock="Right" Width="40" Text="0 ms" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="FeelSmoothingSlider" Minimum="0" Maximum="40" Value="0" TickFrequency="1"
                        ValueChanged="FeelSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Peak soft: rounds off the strongest forces (crashes, big curbs) so they don't slam the wheel, while light and medium forces stay the same. 100% = off. Lower = gentler peaks.">
                <TextBlock Text="Peak soft" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeelPeakSoftValueText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="FeelPeakSoftSlider" Minimum="0.5" Maximum="1" Value="1" TickFrequency="0.01"
                        ValueChanged="FeelSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Soft start: when force feedback first kicks in (game launch, loading into a race), fade it in over this many milliseconds instead of jolting the wheel. Happens once, not every frame. 0 = off.">
                <TextBlock Text="Soft start" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeelSoftStartValueText" DockPanel.Dock="Right" Width="40" Text="0" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="FeelSoftStartSlider" Minimum="0" Maximum="2000" Value="0" TickFrequency="50"
                        ValueChanged="FeelSlider_ValueChanged"/>
              </DockPanel>

              <TextBlock Text="Torque shaping" Opacity="0.7" Margin="0,12,0,4"
                         ToolTip="Optional cleanup for games that send noisy or jumpy torque. Off when Deadband/Slew/DI epsilon are 0 and Spike cap is 100% (as on Raw). Click a value to type."/>
              <DockPanel Margin="0,2,0,0"
                         ToolTip="Deadband: ignores very small forces (fraction of full strength) so the wheel doesn't twitch or hum around center. 0 = off. Try around 0.004.">
                <TextBlock Text="Deadband" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeelDeadbandValueText" DockPanel.Dock="Right" Width="48" Text="0" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="FeelDeadbandSlider" Minimum="0" Maximum="0.05" Value="0" TickFrequency="0.001"
                        ValueChanged="FeelSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Slew: limits how fast the force may change (full-strength units per second). Stops sudden snaps; lower = smoother but less sharp. Releasing to zero is allowed 2.5× faster. 0 = unlimited (off). Try around 40.">
                <TextBlock Text="Slew" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeelSlewValueText" DockPanel.Dock="Right" Width="48" Text="off" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="FeelSlewSlider" Minimum="0" Maximum="200" Value="0" TickFrequency="1"
                        ValueChanged="FeelSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Spike cap: the largest jump allowed in a single update, as a percentage of full strength. Tames one-frame spikes from glitchy games. 100% = off.">
                <TextBlock Text="Spike cap" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeelSpikeValueText" DockPanel.Dock="Right" Width="48" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="FeelSpikeSlider" Minimum="0.05" Maximum="1" Value="1" TickFrequency="0.01"
                        ValueChanged="FeelSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="DI epsilon: skips sending tiny changes to your base (out of 10000). Reduces USB chatter and buzzing on some bases; returning to zero is always sent. 0 = off (every change is sent). Try around 12.">
                <TextBlock Text="DI epsilon" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeelEpsilonValueText" DockPanel.Dock="Right" Width="48" Text="0" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="FeelEpsilonSlider" Minimum="0" Maximum="64" Value="0" TickFrequency="1"
                        ValueChanged="FeelSlider_ValueChanged"/>
              </DockPanel>

              <TextBlock Text="Centering" Opacity="0.7" Margin="0,12,0,4"
                         ToolTip="Extra return-to-center spring added by the emulator, for games that don't center the wheel themselves."/>
              <CheckBox x:Name="ForceCenterCheck" Content="Force center spring" Foreground="#E8EAED"
                        Checked="ForceCenterCheck_Changed" Unchecked="ForceCenterCheck_Changed"
                        ToolTip="Adds a centering spring from your physical rim angle on top of the game's feedback, always on — including menus and pause. Use it for games that leave the wheel loose or never return it to center. Saved with the FFB profile. Off by default."/>
              <StackPanel x:Name="CenterSpringPanel" Margin="0,4,0,0" IsEnabled="False" Opacity="0.5">
                <DockPanel Margin="0,2,0,0"
                           ToolTip="Strength: the maximum centering force (percent of full strength). Scaled by Master. Start around 20–40% on direct-drive bases.">
                  <TextBlock Text="Strength" Width="72" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CenterStrengthValueText" DockPanel.Dock="Right" Width="48" Text="30%" VerticalAlignment="Center"
                             Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                  <Slider x:Name="CenterStrengthSlider" Minimum="0.05" Maximum="1" Value="0.3" TickFrequency="0.01"
                          ValueChanged="FeelSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0"
                           ToolTip="Range: how far from center (percent of full rotation to one side) the spring reaches full strength. Lower = stiffer near center, higher = softer and more gradual.">
                  <TextBlock Text="Range" Width="72" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CenterRangeValueText" DockPanel.Dock="Right" Width="48" Text="25%" VerticalAlignment="Center"
                             Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                  <Slider x:Name="CenterRangeSlider" Minimum="0.05" Maximum="0.5" Value="0.25" TickFrequency="0.01"
                          ValueChanged="FeelSlider_ValueChanged"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0"
                           ToolTip="Deadzone: a small free zone around center where the spring doesn't push, so the wheel doesn't hunt or buzz at dead center. 0 = off.">
                  <TextBlock Text="Deadzone" Width="72" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CenterDeadzoneValueText" DockPanel.Dock="Right" Width="48" Text="off" VerticalAlignment="Center"
                             Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                  <Slider x:Name="CenterDeadzoneSlider" Minimum="0" Maximum="0.05" Value="0" TickFrequency="0.001"
                          ValueChanged="FeelSlider_ValueChanged"/>
                </DockPanel>
              </StackPanel>

              <TextBlock Text="OEM mix" Opacity="0.7" Margin="0,12,0,4"
                         ToolTip="Options applied inside g920ffb.dll while mixing DirectInput effects. Defaults match Raw (pass-through). The Need For Speed Unbound / Heat profile enables the Desktop-era mix."/>
              <CheckBox x:Name="InvertConstantForceCheck" Content="Invert Constant Force" Foreground="#E8EAED" Margin="0,0,0,4"
                        ToolTip="Flip Constant Force polarity only (not Spring/Damper). Used by the Need For Speed Unbound / Heat profile for tire-load direction. Independent of Invert FFB."
                        Checked="MixOption_Changed" Unchecked="MixOption_Changed"/>
              <DockPanel Margin="0,2,0,0"
                         ToolTip="Damper velocity scale: multiplies rim velocity before damper/inertia evaluation. 100% = off. Need For Speed Unbound / Heat uses 200%.">
                <TextBlock Text="Damp vel" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="DamperVelScaleValueText" DockPanel.Dock="Right" Width="48" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="DamperVelScaleSlider" Minimum="0.25" Maximum="4" Value="1" TickFrequency="0.05"
                        ValueChanged="FeelSlider_ValueChanged"/>
              </DockPanel>
              <DockPanel Margin="0,4,0,0"
                         ToolTip="Damper deadband scale: shrinks the game's damper deadband before evaluation. 100% = off. Need For Speed Unbound / Heat uses ~33%.">
                <TextBlock Text="Damp dead" Width="72" VerticalAlignment="Center"/>
                <TextBlock x:Name="DamperDeadbandScaleValueText" DockPanel.Dock="Right" Width="48" Text="100%" VerticalAlignment="Center"
                           Cursor="Hand" ToolTip="Click to type a value" MouseLeftButtonDown="FfbValueLabel_Click"/>
                <Slider x:Name="DamperDeadbandScaleSlider" Minimum="0.1" Maximum="1" Value="1" TickFrequency="0.01"
                        ValueChanged="FeelSlider_ValueChanged"/>
              </DockPanel>

              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox x:Name="InvertFfbCheck" Content="Invert FFB" Foreground="#E8EAED"
                          ToolTip="Flip the force direction. Use it if the wheel pushes away from center instead of toward it."
                          Checked="InvertFfbCheck_Changed" Unchecked="InvertFfbCheck_Changed"/>
                <CheckBox x:Name="FfbDebugCheck" Content="FFB debug" Foreground="#E8EAED" Margin="16,0,0,0"
                          ToolTip="Show FFB test controls and live OEM / HID++ counters (file logging uses the status-bar Debug button)"
                          Checked="FfbDebugCheck_Changed" Unchecked="FfbDebugCheck_Changed"/>
              </StackPanel>

              <StackPanel x:Name="FfbDebugPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="FFB test" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Sends constant force to any DirectInput FFB base (Fanatec, Simucube, Simagic, Moza, generic, etc.). No game required."
                           Opacity="0.65" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                <WrapPanel Margin="0,0,0,4">
                  <Button Style="{StaticResource WrapButton}" Content="Attach FFB" Click="FfbAttach_Click"
                          ToolTip="Debug: acquire the selected wheel for force feedback (Start bridge attaches automatically)"/>
                  <Button Style="{StaticResource WrapButton}" Content="Left" Click="FfbTestLeft_Click"/>
                  <Button Style="{StaticResource WrapButton}" Content="Center" Click="FfbTestCenter_Click"
                          ToolTip="Toggle return-to-center spring (reads physical rim; same idea as game DI Spring)"/>
                  <Button Style="{StaticResource WrapButton}" Content="Right" Click="FfbTestRight_Click"/>
                  <Button Style="{StaticResource WrapButton}" Content="Pulse" Click="FfbTestPulse_Click"
                          ToolTip="Short left/right pulse"/>
                  <Button Style="{StaticResource WrapButton}" Content="Release test" Click="FfbTestRelease_Click"
                          Margin="0,0,0,8"
                          ToolTip="Clear test override so game FFB can drive again"/>
                </WrapPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock Text="Test torque" Width="72" VerticalAlignment="Center"/>
                  <TextBlock x:Name="FfbTestTorqueValueText" DockPanel.Dock="Right" Width="48"
                             Text="0%" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                  <Slider x:Name="FfbTestTorqueSlider" Minimum="-1" Maximum="1" Value="0"
                          TickFrequency="0.05" IsSnapToTickEnabled="False"
                          ValueChanged="FfbTestTorqueSlider_ValueChanged"/>
                </DockPanel>
                <TextBlock x:Name="FfbDiagText" Opacity="0.8" FontSize="11" TextWrapping="Wrap"
                           FontFamily="Consolas" Margin="0,8,0,0"
                           Text="FFB diagnostics will appear here."/>
              </StackPanel>

              <TextBlock Text="Shifter mode" Opacity="0.7" Margin="0,12,0,4"/>
              <ComboBox x:Name="ShifterModeCombo" SelectionChanged="ShifterModeCombo_SelectionChanged">
                <ComboBoxItem Content="Exclusive H-pattern" Tag="ExclusiveHPattern" IsSelected="True"/>
                <ComboBoxItem Content="Passthrough" Tag="Passthrough"/>
              </ComboBox>
            </StackPanel>
          </Border>

          <TextBlock x:Name="DriverText" Text="" Opacity="0.65" TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
