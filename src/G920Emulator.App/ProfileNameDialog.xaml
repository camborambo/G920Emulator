<Window x:Class="G920Emulator.App.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile name"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="180" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#121418"
        Foreground="#E8EAED"
        FontFamily="Segoe UI">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="90" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
      <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click" Background="#1F6F4A" BorderBrush="#2F9E6B" Margin="0"/>
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Profile name" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox x:Name="NameBox" Padding="8,6"/>
    </StackPanel>
  </DockPanel>
</Window>
