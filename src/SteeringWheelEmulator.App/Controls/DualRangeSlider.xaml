<UserControl x:Class="SteeringWheelEmulator.App.Controls.DualRangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28" MinWidth="80"
             ClipToBounds="False"
             Background="Transparent"
             Focusable="True"
             SnapsToDevicePixels="True">
  <!--
    7px side padding so end thumbs (centered on 0%/100%) stay fully visible.
    Transparent background = full-height hit target in the bindings list.
  -->
  <Grid Margin="7,0" Background="Transparent">
    <Border Height="4" VerticalAlignment="Center"
            Background="{DynamicResource BorderSubtle}" CornerRadius="2"
            IsHitTestVisible="False"/>
    <Canvas x:Name="ThumbCanvas" ClipToBounds="False" Background="Transparent">
      <Border x:Name="TrackSelected" Height="4" Canvas.Top="12"
              Background="{DynamicResource AccentPrimary}" CornerRadius="2"
              IsHitTestVisible="False"/>
      <!-- 22×28 hit box, 14px visual — easier to grab in the bindings list -->
      <Thumb x:Name="LowerThumb" Width="22" Height="28" Cursor="SizeWE"
             DragDelta="LowerThumb_DragDelta" DragStarted="Thumb_DragStarted" DragCompleted="Thumb_DragCompleted">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent" Width="22" Height="28">
              <Ellipse Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Fill="{DynamicResource TextPrimary}" Stroke="{DynamicResource AccentPrimary}"
                       StrokeThickness="1.5"/>
            </Grid>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
      <Thumb x:Name="UpperThumb" Width="22" Height="28" Cursor="SizeWE"
             DragDelta="UpperThumb_DragDelta" DragStarted="Thumb_DragStarted" DragCompleted="Thumb_DragCompleted">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent" Width="22" Height="28">
              <Ellipse Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Fill="{DynamicResource TextPrimary}" Stroke="{DynamicResource AccentPrimary}"
                       StrokeThickness="1.5"/>
            </Grid>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Canvas>
  </Grid>
</UserControl>
